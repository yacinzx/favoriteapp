# Supabase project credentials (get these from Supabase Dashboard → Project Settings → API)
# Copy this file to ".env" and fill in your values. Never commit the real .env.
#
# The ANON public key is safe to ship in the browser — access is protected by
# Row Level Security so users can only ever read/write their OWN favorites.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
